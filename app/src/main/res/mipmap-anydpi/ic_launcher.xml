<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <shape android:shape="rectangle">
            <solid android:color="#A1C0AE" />
        </shape>
    </background>
    <foreground>
        <!-- The original square occupies the adaptive icon's 72 dp viewport. -->
        <inset android:inset="16.666667%">
            <bitmap
                android:src="@drawable/terraria_toolbox_logo"
                android:gravity="fill"
                android:antialias="true"
                android:filter="true" />
        </inset>
    </foreground>
</adaptive-icon>
